# ─────────────────────────────────────────────────────────────
# Supabase connection
#
# Local development (.env.local) → STAGING Supabase project
# Vercel env vars                → PRODUCTION Supabase project
#
# Keep these two projects separate so local testing never touches
# production data. Bootstrap a fresh project with
# supabase/staging-setup.sql, then seed users via
# `node scripts/seed-users.mjs`.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Online ordering payments (order.machimoto.cafe) ──
# Leave PAYMENT_PROVIDER unset (or not "doku") to use the built-in mock QRIS.
# Set to "doku" and fill the keys below to use DOKU Checkout.
PAYMENT_PROVIDER=
DOKU_ENV=sandbox           # sandbox | production
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
ORDER_BASE_URL=https://myorder.machimoto.cafe   # used for DOKU return + callback URLs
