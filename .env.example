# ─────────────────────────────────────────────────────────────
# Supabase connection
#
# Local development (.env.local) → STAGING Supabase project
# Vercel env vars                → PRODUCTION Supabase project
#
# Keep these two projects separate so local testing never touches
# production data. Bootstrap a fresh project with
# supabase/staging-setup.sql, then seed users via
# `node scripts/seed-users.mjs`.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Online ordering payments (order.machimoto.cafe) ──
# Leave PAYMENT_PROVIDER unset (or not "doku") to use the built-in mock QRIS.
# Set to "doku" and fill the keys below to use DOKU Checkout.
PAYMENT_PROVIDER=
DOKU_ENV=sandbox           # sandbox | production
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
ORDER_BASE_URL=https://order.machimoto.cafe   # used for DOKU return + callback URLs

# ── Telegram purchasing bot ──
# Create the bot with @BotFather. Use a SEPARATE bot for local development.
# Production: set these in Vercel, then Purchasing → Telegram → "Pasang webhook".
# Local: run `node scripts/telegram-poll.mjs` alongside the dev server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # optional, without @ (otherwise fetched via getMe)
TELEGRAM_WEBHOOK_SECRET=        # random string, e.g. `openssl rand -hex 32`
APP_BASE_URL=                   # e.g. https://admin.machimoto.cafe — links in messages + webhook URL
# Parsing free-text requests uses Vercel AI Gateway:
AI_GATEWAY_API_KEY=             # not needed on Vercel when OIDC is available
TELEGRAM_PARSE_MODEL=           # optional, default anthropic/claude-haiku-5.5
